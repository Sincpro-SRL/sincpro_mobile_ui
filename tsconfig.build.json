{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "./dist",
    "rootDir": "./sincpro_mobile_ui",
    "jsx": "react-jsx",
    "jsxImportSource": "nativewind",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "sourceMap": false,
    "declarationMap": false
  },
  "include": [
    "sincpro_mobile_ui/**/*.ts",
    "sincpro_mobile_ui/**/*.tsx",
    "sincpro_mobile_ui/nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "**/__tests__", "**/*.test.*"]
}
